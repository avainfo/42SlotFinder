{
	"manifest_version": 3,
	"name": "42 Slot Watcher",
	"icons": {
		"16": "icons/icon16.png",
		"32": "icons/icon32.png",
		"48": "icons/icon48.png",
		"128": "icons/icon128.png"
	},
	"version": "0.1.0",
	"description": "Watch 42 evaluation slots by pattern",
	"action": {
		"default_title": "42 Slot Watcher"
	},
	"content_scripts": [
		{
			"matches": [
				"https://projects.intra.42.fr/projects/*",
				"https://*.42network.org/*"
			],
			"js": [
				"dist/index.js"
			],
			"css": [
				"injected.css"
			]
		}
	],
	"permissions": []
}
